NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# How often the monitoring page polls GET .../monitoring/current (Step 6).
# Accepts a plain number of seconds or a Go-style duration string (30s,
# 1m). The backend's own collection interval (VM_MONITOR_INTERVAL) is
# separate and independently configurable -- see docs/vm-monitoring.md.
NEXT_PUBLIC_MONITORING_REFRESH=30s

# Active subscription plan (community | team | business | enterprise) --
# drives the Plans & Billing page's limits. See src/lib/plans.ts. In the
# Docker image set INFRAHUB_PLAN / INFRAHUB_MARKETING_URL on the container
# instead (read at runtime, see src/lib/runtime-config.ts).
NEXT_PUBLIC_INFRAHUB_PLAN=community

# Public marketing/pricing site (infrahub-site/), linked from Plans & Billing.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
